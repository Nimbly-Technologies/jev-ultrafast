TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Chrome DevTools HTTP endpoint, as seen from CDP_SSH (or from this machine when CDP_SSH is empty).
# Remote example: CDP_URL=http://100.85.222.1:9222 with CDP_SSH=ben@kids tunnels through SSH.
CDP_URL=http://127.0.0.1:9222
CDP_SSH=
# Optional. JSON {field label substring: value} for password fields; typed locally, never sent to a model.
JEV_SECRETS=
